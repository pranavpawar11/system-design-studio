# Which back end the app talks to.
#   local (default): browser storage + bundled questions. No server needed.
#   http: a real REST API implementing docs/API.md
VITE_API_MODE=local
# Used when VITE_API_MODE=http
VITE_API_BASE_URL=/api/v1
# Local mode only: simulate network delay (milliseconds) to test loading states
VITE_API_LATENCY_MS=0
