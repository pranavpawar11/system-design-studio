{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hld-studio.local/schemas/lesson.schema.json",
  "title": "HLD Studio lesson file",
  "description": "One lesson. File name: src/data/learning/lessons/<id>.json. The id must match a lesson in roadmap.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "summary", "minutes", "blocks"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Same as the roadmap node id and the file name." },
    "title": { "type": "string", "minLength": 3, "maxLength": 80 },
    "summary": { "type": "string", "minLength": 20, "maxLength": 220, "description": "One or two sentences shown under the title." },
    "minutes": { "type": "integer", "minimum": 3, "maximum": 60, "description": "Honest time to read, run the lab and answer the quiz." },
    "blocks": {
      "type": "array", "minItems": 3,
      "items": {
        "oneOf": [
          { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "heading" }, "level": { "enum": [2, 3] }, "text": { "type": "string", "minLength": 2 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "text"], "properties": { "type": { "const": "paragraph" }, "text": { "type": "string", "minLength": 10 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "items"], "properties": { "type": { "const": "list" }, "ordered": { "type": "boolean" }, "items": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 2 } } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "tone", "text"], "properties": { "type": { "const": "callout" }, "tone": { "enum": ["info", "tip", "warning"] }, "title": { "type": "string" }, "text": { "type": "string", "minLength": 10 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "title", "text"], "properties": { "type": { "const": "example" }, "title": { "type": "string", "minLength": 2 }, "text": { "type": "string", "minLength": 20 } } },
          { "type": "object", "additionalProperties": false, "required": ["type", "expression"], "properties": { "type": { "const": "formula" }, "expression": { "type": "string", "minLength": 3 }, "caption": { "type": "string" }, "variables": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["name", "meaning"], "properties": { "name": { "type": "string" }, "meaning": { "type": "string" } } } } } }
        ]
      }
    },
    "lab": {
      "type": "object", "additionalProperties": false,
      "required": ["title", "intro", "inputs", "derived", "narrative", "tasks"],
      "properties": {
        "title": { "type": "string", "minLength": 3 }, "intro": { "type": "string", "minLength": 10 },
        "inputs": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "label", "default"], "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }, "label": { "type": "string" }, "unit": { "type": "string" }, "type": { "enum": ["slider", "toggle"] },
          "min": { "type": "number" }, "max": { "type": "number" }, "step": { "type": "number" }, "default": { "type": "number" }, "format": { "enum": ["integer", "decimal1", "decimal2", "percent"] }, "help": { "type": "string" } } } },
        "derived": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "formula"], "properties": {
          "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" }, "label": { "type": "string" }, "unit": { "type": "string" }, "formula": { "type": "string" }, "format": { "enum": ["integer", "decimal1", "decimal2", "percent"] }, "output": { "type": "boolean" } } } },
        "narrative": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/message" } },
        "notes": { "type": "array", "items": { "$ref": "#/definitions/message" } },
        "sweep": { "type": "object", "additionalProperties": false, "required": ["input", "output", "title"], "properties": { "input": { "type": "string" }, "output": { "type": "string" }, "title": { "type": "string" }, "reference": { "type": "object", "additionalProperties": false, "required": ["label", "value"], "properties": { "label": { "type": "string" }, "value": { "type": "string" } } } } },
        "scenarios": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["label", "set"], "properties": { "label": { "type": "string" }, "set": { "type": "object", "additionalProperties": { "type": "number" } } } } },
        "tasks": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text", "check"], "properties": { "id": { "type": "string" }, "text": { "type": "string", "minLength": 10 }, "check": { "type": "string" } } } }
      }
    },
    "quiz": {
      "type": "object", "additionalProperties": false, "required": ["passScore", "questions"],
      "properties": {
        "passScore": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "questions": { "type": "array", "minItems": 2, "items": { "type": "object", "additionalProperties": false, "required": ["id", "prompt", "options", "correct", "explanation"], "properties": {
          "id": { "type": "string" }, "prompt": { "type": "string", "minLength": 10 },
          "options": { "type": "array", "minItems": 2, "maxItems": 5, "items": { "type": "object", "additionalProperties": false, "required": ["id", "text"], "properties": { "id": { "type": "string" }, "text": { "type": "string", "minLength": 1 } } } },
          "correct": { "type": "string" }, "explanation": { "type": "string", "minLength": 20 } } } }
      }
    },
    "practice": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["questionId", "label"], "properties": { "questionId": { "type": "string" }, "label": { "type": "string" } } } }
  },
  "definitions": { "message": { "type": "object", "additionalProperties": false, "required": ["when", "tone", "text"], "properties": { "when": { "type": "string" }, "tone": { "enum": ["ok", "warn", "bad", "info"] }, "text": { "type": "string", "minLength": 10 } } } }
}
