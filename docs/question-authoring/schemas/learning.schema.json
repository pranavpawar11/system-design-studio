{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hld-studio.local/schemas/learning.schema.json",
  "title": "HLD Studio learning file",
  "description": "Follow-up questions, reference designs and revision advice for one question. File name: <slug>.learning.json",
  "type": "object",
  "required": ["followUpQuestions", "referenceSolutions", "revisionRecommendations"],
  "properties": {
    "followUpQuestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "difficulty", "category", "prompt", "expectedAnswerPoints"],
        "properties": {
          "id": { "type": "string" },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "category": { "type": "string" },
          "prompt": { "type": "string", "minLength": 10 },
          "expectedAnswerPoints": { "type": "array", "minItems": 2, "items": { "type": "string" }, "description": "The learner ticks these off themselves, so write each as one checkable idea." }
        }
      }
    },
    "referenceSolutions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "difficulty", "architecture", "flows", "strengths", "limitations", "tradeoffs"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string" },
          "difficulty": { "enum": ["easy", "medium", "hard"] },
          "architecture": { "$ref": "#/definitions/architectureDocument" },
          "flows": { "type": "array", "minItems": 1, "items": { "type": "object", "required": ["name", "steps"], "properties": { "name": { "type": "string" }, "steps": { "type": "array", "minItems": 2, "items": { "type": "string" } } } } },
          "strengths": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "limitations": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "tradeoffs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
        }
      }
    },
    "revisionRecommendations": {
      "type": "array",
      "items": { "type": "object", "required": ["requirementIds", "text"], "properties": { "requirementIds": { "type": "array", "minItems": 1, "items": { "type": "string" } }, "text": { "type": "string" } } }
    }
  },
  "definitions": {
    "architectureDocument": {
      "type": "object",
      "required": ["schemaVersion", "questionId", "questionVersion", "nodes", "edges"],
      "properties": {
        "schemaVersion": { "const": 1 },
        "questionId": { "type": "string" },
        "questionVersion": { "type": "integer" },
        "nodes": { "type": "array", "items": { "type": "object", "required": ["id", "componentId", "componentType", "name", "position", "config"], "properties": { "id": { "type": "string" }, "componentId": { "type": "string" }, "componentType": { "type": "string" }, "name": { "type": "string" }, "position": { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } }, "config": { "type": "object" } } } },
        "edges": { "type": "array", "items": { "type": "object", "required": ["id", "source", "target", "connectionTypeId"], "properties": { "id": { "type": "string" }, "source": { "type": "string" }, "target": { "type": "string" }, "connectionTypeId": { "type": "string" } } } }
      }
    }
  }
}
