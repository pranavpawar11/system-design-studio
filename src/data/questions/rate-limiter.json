 "hints": [
  {
   "id": "HINT-RL-01",
   "level": 1,
   "text": "Where in the request path should the check happen so that no request can skip it?"
  },
  {
   "id": "HINT-RL-02",
   "level": 2,
   "text": "If you run several limiter servers, where do their counts live so they all agree on how many requests a client has made?"
  },
  {
   "id": "HINT-RL-03",
   "level": 3,
   "text": "What should the limiter do with a request that is over the limit, and what does the caller see?"
  },
  {
   "id": "HINT-RL-04",
   "level": 4,
   "text": "Pick an algorithm and say why. How does it treat a short burst of traffic compared with steady traffic?"
  },
  {
   "id": "HINT-RL-05",
   "level": 5,
   "text": "What should happen if the counter store is down: let every request through (fail-open) or block every request (fail-closed)? What does each choice risk?"
  }
 ]
