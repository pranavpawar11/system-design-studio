{
 "schemaVersion": "1.0.0",
 "question": {
  "id": "hld-url-shortener-001",
  "version": 1,
  "slug": "design-url-shortener",
  "title": "Design a URL Shortener",
  "difficulty": "beginner",
  "estimatedMinutes": 45
 },
 "requirements": {
  "functional": [
   {
    "id": "FR-01",
    "title": "Create a short URL",
    "priority": "must",
    "evaluationRuleIds": [
     "RULE-FR-01"
    ]
   },
   {
    "id": "FR-02",
    "title": "Redirect to the original URL",
    "priority": "must",
    "evaluationRuleIds": [
     "RULE-FR-02"
    ]
   },
   {
    "id": "FR-03",
    "title": "Maintain short-code uniqueness",
    "priority": "must",
    "evaluationRuleIds": [
     "RULE-FR-03"
    ]
   },
   {
    "id": "FR-04",
    "title": "Handle unknown short codes",
    "priority": "must",
    "evaluationRuleIds": [
     "RULE-FR-04"
    ]
   },
   {
    "id": "FR-05",
    "title": "Support high-volume redirects",
    "priority": "must",
    "evaluationRuleIds": [
     "RULE-FR-05"
    ]
   },
   {
    "id": "FR-06",
    "title": "Validate submitted destinations",
    "priority": "must",
    "evaluationRuleIds": [
     "RULE-FR-06"
    ]
   }
  ],
  "nonFunctional": [
   {
    "id": "NFR-01",
    "title": "Redirect latency",
    "priority": "must",
    "target": {
     "operator": "less_than",
     "value": 200,
     "unit": "ms",
     "statistic": "p95"
    }
   },
   {
    "id": "NFR-02",
    "title": "Read scalability",
    "priority": "must",
    "target": {
     "requestsPerSecond": 10000,
     "trafficType": "redirect"
    }
   },
   {
    "id": "NFR-03",
    "title": "Data integrity",
    "priority": "must"
   },
   {
    "id": "NFR-04",
    "title": "Application availability",
    "priority": "should",
    "target": {
     "availabilityPercent": 99.9
    }
   },
   {
    "id": "NFR-05",
    "title": "Durable URL mappings",
    "priority": "must"
   }
  ]
 },
