{
 "description": "Catalogue extensions merged into the question at load time. Idempotent: safe if the base JSON already contains them.",
 "components": [
  {
   "id": "COMP-WAF",
   "type": "waf",
   "category": "Security",
   "displayName": "Web Application Firewall",
   "responsibilities": [
    "Block malicious and abusive traffic before it reaches the application",
    "Filter known bad URL patterns"
   ],
   "supportedOperations": [
    "http-routing",
    "request-rate-check"
   ],
   "defaultConfig": {
    "averageLatencyMs": 2
   }
  },
  {
   "id": "COMP-AUTH",
   "type": "auth-service",
   "category": "Security",
   "displayName": "Auth Service",
   "responsibilities": [
    "Authenticate API callers",
    "Issue and validate tokens"
   ],
   "supportedOperations": [
    "http-request",
    "authentication"
   ],
   "defaultConfig": {
    "averageLatencyMs": 5
   }
  },
  {
   "id": "COMP-READ-REPLICA",
   "type": "read-replica",
   "category": "Storage",
   "displayName": "Read Replica",
   "responsibilities": [
    "Serve read traffic replicated from the primary database",
    "Absorb cache misses"
   ],
   "supportedOperations": [
    "durable-read",
    "indexed-lookup",
    "key-lookup",
    "replication-target"
   ],
   "defaultConfig": {
    "readCapacityRps": 5000,
    "averageReadLatencyMs": 20,
    "durable": true,
    "replicationLagMs": 100
   },
   "configSchema": {
    "readCapacityRps": {
     "type": "number",
     "exclusiveMinimum": 0
    },
    "averageReadLatencyMs": {
     "type": "number",
     "minimum": 0
    },
    "replicationLagMs": {
     "type": "number",
     "minimum": 0
    }
   }
  },
  {
   "id": "COMP-ANALYTICS-STORE",
   "type": "analytics-store",
   "category": "Storage",
   "displayName": "Analytics Store",
   "responsibilities": [
    "Store click events (append-only)",
    "Serve aggregate queries"
   ],
   "supportedOperations": [
    "append-write",
    "aggregate-query"
   ],
   "defaultConfig": {
    "writeCapacityRps": 5000,
    "averageWriteLatencyMs": 10,
    "durable": true
   }
  },
  {
   "id": "COMP-LOGGING",
   "type": "logging",
   "category": "Observability",
   "displayName": "Logging & Tracing",
   "responsibilities": [
    "Collect structured logs",
    "Trace requests across services"
   ],
   "supportedOperations": [
    "collect-logs",
    "collect-traces"
   ],
   "defaultConfig": {}
  }
 ],
 "connectionTypes": [
  {
   "id": "EDGE-ASYNC-CONSUME",
   "name": "Queue Consume",
   "semantics": "The target consumes messages buffered by the source queue.",
   "compatibleSourceOperations": [
    "buffer-work"
   ],
   "compatibleTargetOperations": [
    "consume-message"
   ]
  },
  {
   "id": "EDGE-ID-ALLOC",
   "name": "ID Allocation",
   "semantics": "The source requests an identifier or short code from the target generator.",
   "compatibleSourceOperations": [
    "short-code-generation"
   ],
   "compatibleTargetOperations": [
    "generate-identifier",
    "allocate-identifier"
   ]
  },
  {
   "id": "EDGE-REPLICATION",
   "name": "Replication",
   "semantics": "The source primary store replicates data to the target replica.",
   "compatibleSourceOperations": [
    "unique-constraint",
    "conditional-write"
   ],
   "compatibleTargetOperations": [
    "replication-target"
   ]
  },
  {
   "id": "EDGE-TELEMETRY",
   "name": "Telemetry",
   "semantics": "The source emits metrics, logs or health signals to the target collector.",
   "compatibleSourceOperations": [
    "http-request",
    "request-distribution",
    "durable-read",
    "cache-read",
    "consume-message"
   ],
   "compatibleTargetOperations": [
    "collect-metrics",
    "collect-health",
    "collect-logs",
    "collect-traces"
   ]
  }
 ],
 "categories": {
  "client": "Clients",
  "dns": "Networking",
  "cdn": "Networking",
  "load-balancer": "Networking",
  "api-gateway": "Networking",
  "application-server": "Compute",
  "worker": "Compute",
  "key-generator": "Compute",
  "sql-database": "Storage",
  "nosql-database": "Storage",
  "cache": "Caching",
  "message-queue": "Messaging",
  "rate-limiter": "Security",
  "metrics-collector": "Observability"
 },
 "addOperations": {
  "COMP-APP-SERVER": [
   "publish-message"
  ]
 },
 "renames": {
  "COMP-KEY-GENERATOR": "ID / Short-Code Generator"
 },
 "connectionPatches": {
  "EDGE-DB-WRITE": {
   "addSourceOperations": [
    "process-job"
   ],
   "addTargetOperations": [
    "append-write"
   ]
  }
 },
 "configDefaults": {
  "COMP-APP-SERVER": {
   "notFoundBehavior": "undeclared"
  },
  "COMP-CACHE": {
   "onUnavailable": "undeclared"
  }
 },
 "configSchemaPatch": {
  "COMP-APP-SERVER": {
   "notFoundBehavior": {
    "type": "string",
    "enum": [
     "undeclared",
     "return-404"
    ]
   }
  },
  "COMP-CACHE": {
   "onUnavailable": {
    "type": "string",
    "enum": [
     "undeclared",
     "bypass-to-database",
     "fail-request"
    ]
   }
  }
 }
}